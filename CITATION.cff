    given-names: Pádraig
    orcid: "https://orcid.org/0000-0003-3885-2439"
version: 0.1.0
doi: 10.5281/zenodo.23425506
date-released: 2026-10-16
license: Apache-2.0
repository-code: "https://github.com/padge01/bestpred-python"
keywords:
  - dairy
  - lactation
  - best prediction
  - DHI
  - animal science
references:
